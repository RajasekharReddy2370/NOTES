if __name__ == "__main__":
    app.run(debug=True)

--------------------------------------- user_routes.py ---------------------------
from flask import Blueprint

user_bp = Blueprint("user", __name__)

@user_bp.route("/users", methods=["GET"])
def get_users():
    return {"message": "All Users"}

@user_bp.route("/users", methods=["POST"])
def create_user():
    return {"message": "User Created"}

